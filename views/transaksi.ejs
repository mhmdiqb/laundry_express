<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Transaksi Laundry</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<div class="sidebar">

    <h2>Laundry App</h2>

    <ul>

        <li>
            <a href="/">
                Dashboard
            </a>
        </li>


        <% if(user && (user.role === 'admin' || user.role === 'kasir')){ %> 

        <li>
            <a href="/transaksi">
                Transaksi
            </a>
        </li>


        <li>
            <a href="/pelanggan">
                Pelanggan
            </a>
        </li>


        <li>
            <a href="/cek-laundry">
                Cek Laundry
            </a>
        </li>

        <% } %>



        <% if(user && user.role === 'admin'){ %>

        <li>
            <a href="/laporan">
                Laporan
            </a>
        </li>

        <% } %>



        <li>
            <a href="/logout">
                Logout
            </a>
        </li>


    </ul>

</div>

<div class="main">

    <h1>Manajemen Transaksi</h1>

    <div class="card">

        <form action="/tambah" method="POST">

            <label>Pilih Pelanggan</label>

            <div style="display:flex;gap:10px;">

            <select
            id="id_pelanggan"
            name="id_pelanggan"
            style="flex:1;"
            required>

            <option value="">-- Pilih Pelanggan --</option>

            <% pelanggan.forEach(p=>{ %>

            <option
            value="<%= p.Id %>"
            data-nama="<%= p.nama %>"
            data-nohp="<%= p.nohp %>"
            data-alamat="<%= p.alamat %>">

            <%= p.nama %> - <%= p.nohp %>

            </option>

            <% }) %>

            </select>

            <a href="/pelanggan" class="edit">
            + Pelanggan Baru
            </a>

            </div>

            <br>

            <label>Nama</label>

            <input
            type="text"
            id="nama"
            readonly>

            <label>No HP</label>

            <input
            type="text"
            id="nohp"
            readonly>

            <label>Alamat</label>

            <textarea
            id="alamat"
            rows="2"
            readonly></textarea>

            <br>

            <select name="layanan">
                <option>Cuci Kering</option>
                <option>Cuci Setrika</option>
                <option>Express</option>
            </select>

            <input
                type="number"
                name="jumlah_baju"
                placeholder="Jumlah Baju"
                value=""
            >

            <input
                type="number"
                name="jumlah_celana"
                placeholder="Jumlah Celana"
                value=""
            >

            <input
                type="number"
                name="jumlah_jaket"
                placeholder="Jumlah Jaket"
                value=""
            >

            <input
                type="number"
                name="jumlah_kerudung"
                placeholder="Jumlah Kerudung"
                value=""
            >

            <input
                type="number"
                name="jumlah_koko"
                placeholder="Jumlah Koko"
                value=""
            >

            <input
                type="number"
                name="jumlah_handuk"
                placeholder="Jumlah Handuk"
                value=""
            >

            <input
                type="number"
                name="jumlah_kemeja"
                placeholder="Jumlah Kemeja"
                value=""
            >

            <input
                type="number"
                name="jumlah_sarung"
                placeholder="Jumlah Sarung"
                value=""
            >

            <input
                type="number"
                name="jumlah_gamis"
                placeholder="Jumlah Gamis"
                value=""
            >

            <input
                type="number"
                name="jumlah_mukena"
                placeholder="Jumlah Mukena"
                value=""
            >

            <input type="number" name="berat" placeholder="Berat Cucian" required>

            <select name="status">
                <option>Diproses</option>
                <option>Selesai</option>
            </select>

            <button type="submit">Tambah Transaksi</button>

        </form>

    </div>

    <div class="card">
    <input 
    type="text"
    id="searchInput"
    placeholder="Cari pelanggan..."
    >

        <table>

            <thead>
                <tr>
                    <th>Nama</th>
                    <th>Layanan</th>
                    <th>Berat</th>
                    <th>Status</th>
                    <th>Estimasi</th>
                    <th>Harga</th>
                    <th>Aksi</th>
                </tr>
            </thead>

            <tbody id="tableBody">

                <% transaksi.forEach(data => { %>

                    <tr>
                        <td><%= data.nama %></td>
                        <td><%= data.layanan %></td>
                        <td><%= data.berat %> Kg</td>
                        <td><%= new Date(data.estimasi_selesai).toLocaleDateString('id-ID') %></td>
                        <td><%= data.status %></td>
                        <td>Rp <%= data.harga.toLocaleString('id-ID') %></td>

                        <td>
                            <a class="edit" href="/edit/<%= data.id %>">
                                Edit
                            </a>

                            <a class="hapus" href="/hapus/<%= data.id %>">
                                Hapus
                            </a>

                            <a class="print" href="/nota/<%= data.id %>">
                                Print
                            </a>
                        </td>
                    </tr>

                <% }) %>

            </tbody>

        </table>

    </div>

</div>

<div class="modal fade" id="modalPelanggan">

<div class="modal-dialog">

<div class="modal-content">

<div class="modal-header">
<h5>Tambah Pelanggan</h5>
</div>

<div class="modal-body">

<form action="/pelanggan/tambah" method="POST">

<input
type="text"
name="nama"
class="form-control mb-2"
placeholder="Nama"
required>

<input
type="text"
name="nohp"
class="form-control mb-2"
placeholder="No HP"
required>

<textarea
name="alamat"
class="form-control mb-2"
placeholder="Alamat"></textarea>

<button class="btn btn-primary w-100">
Simpan
</button>

</form>

</div>

</div>

</div>

</div>

<script>

const searchInput = document.getElementById('searchInput');

searchInput.addEventListener('keyup', function(){

    const keyword = searchInput.value.toLowerCase();

    const rows = document.querySelectorAll('#tableBody tr');

    rows.forEach(row => {

        const text = row.textContent.toLowerCase();

        if(text.includes(keyword)){
            row.style.display = '';
        }else{
            row.style.display = 'none';
        }

    });
});

const pelanggan = document.getElementById('id_pelanggan');

pelanggan.addEventListener('change', function(){

    const option = this.options[this.selectedIndex];

    document.getElementById('nama').value =
        option.dataset.nama || '';

    document.getElementById('nohp').value =
        option.dataset.nohp || '';

    document.getElementById('alamat').value =
        option.dataset.alamat || '';

});

</script>

</body>
</html>