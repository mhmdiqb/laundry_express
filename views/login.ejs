<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Login Admin</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<div class="login-container">

    <div class="login-box">

        <h1>Login Admin</h1>

        <form action="/login" method="POST">

            <input 
                type="text"
                name="username"
                placeholder="Username"
                required
            >

            <input 
                type="password"
                name="password"
                placeholder="Password"
                required
            >

            <button type="submit">
                Login
            </button>

        </form>

    </div>

</div>

</body>
</html>